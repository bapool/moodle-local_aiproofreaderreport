<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aiproofreaderreport/db" VERSION="20260901" COMMENT="XMLDB file for Moodle local/aiproofreaderreport"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_aiproofreaderreport_optout" COMMENT="Roster of students whose parents opted out (via ParentSquare) - excluded from the anonymized export. Each import replaces the full roster.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="studentnumber" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Matched against {user}.idnumber (the district SSID)."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="importedby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="userid of the admin who ran the import."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="studentnumber" UNIQUE="false" FIELDS="studentnumber"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
